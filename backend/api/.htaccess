# backend/api/.htaccess
# Enables cross-origin requests and PHP processing for all .php files.
# Required for XAMPP local development and Apache in production.

Options -Indexes

# Ensure PHP files are processed
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>

# Allow Authorization header to pass through to PHP
# (Apache strips it by default unless this is set)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
